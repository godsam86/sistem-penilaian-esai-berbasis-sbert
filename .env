# Salin file ini ke .env lalu isi nilai sebenarnya sebelum `docker compose up`.

# --- Django ---
DJANGO_SECRET_KEY=ganti-dengan-secret-key-acak-yang-panjang
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=esai_db
POSTGRES_USER=esai_user
POSTGRES_PASSWORD= esai_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS (frontend yang boleh mengakses API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Bootstrap akun admin pertama (bagian 30) ---
ADMIN_EMAIL=admin@gmail.com
ADMIN_NAMA=Administrator
ADMIN_PASSWORD=admin123

# --- Parameter scoring (bagian 16) ---
SBERT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_WEIGHT=0.80
CONCEPT_WEIGHT=0.20
TOP_K=3
CONCEPT_THRESHOLD=0.60
TEXT_MIN_WORDS=5
TEXT_MIN_ALPHA_RATIO=0.75
TEXT_MIN_VOWEL_RATIO=0.50
TEXT_MAX_UPPER_RATIO=0.50
SEMANTIC_MIN_THRESHOLD=0.25
SEMANTIC_BASELINE=0.40
SEMANTIC_BELOW_BASELINE_MAX=20
NOISE_PENALTY=0.10
